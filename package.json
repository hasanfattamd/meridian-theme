{
  "name": "meridian-theme",
  "type": "module",
  "displayName": "Meridian Dark Suite",
  "description": "A developer-first, precisely calibrated dark theme for VS Code, generated by the Meridian design system.",
  "version": "1.0.0",
  "publisher": "mohammedhasanfatta",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "meridian",
    "theme",
    "dark",
    "color-theme",
    "design-system"
  ],
  "galleryBanner": {
    "color": "#121212",
    "theme": "dark"
  },
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/hasanfattamd/meridian-theme.git"
  },
  "homepage": "https://github.com/hasanfattamd/meridian-theme#readme",
  "bugs": {
    "url": "https://github.com/hasanfattamd/meridian-theme/issues"
  },
  "license": "MIT",
  "contributes": {
    "themes": [
      {
        "label": "Meridian Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/meridian-dark-color-theme.json"
      },
      {
        "label": "Meridian Dark Ultimate",
        "uiTheme": "vs-dark",
        "path": "./themes/meridian-dark-ultimate-color-theme.json"
      },
      {
        "label": "Meridian Dark Noir",
        "uiTheme": "vs-dark",
        "path": "./themes/meridian-dark-noir-color-theme.json"
      },
      {
        "label": "Meridian Dark Fire",
        "uiTheme": "vs-dark",
        "path": "./themes/meridian-dark-fire-color-theme.json"
      },
      {
        "label": "Meridian Dark Luxe",
        "uiTheme": "vs-dark",
        "path": "./themes/meridian-dark-luxe-color-theme.json"
      },
      {
        "label": "Meridian Dark Midnight Glow",
        "uiTheme": "vs-dark",
        "path": "./themes/meridian-dark-midnight-glow-color-theme.json"
      },
      {
        "label": "Meridian Dark Elegance",
        "uiTheme": "vs-dark",
        "path": "./themes/meridian-dark-elegance-color-theme.json"
      },
      {
        "label": "Meridian Dark Deep Sea",
        "uiTheme": "vs-dark",
        "path": "./themes/meridian-dark-deep-sea-color-theme.json"
      },
      {
        "label": "Meridian Dark Slate",
        "uiTheme": "vs-dark",
        "path": "./themes/meridian-dark-slate-color-theme.json"
      },
      {
        "label": "Meridian Dark Deep Wine",
        "uiTheme": "vs-dark",
        "path": "./themes/meridian-dark-deep-wine-color-theme.json"
      },
      {
        "label": "Meridian Dark Forest",
        "uiTheme": "vs-dark",
        "path": "./themes/meridian-dark-forest-color-theme.json"
      },
      {
        "label": "Meridian Dark Umbra",
        "uiTheme": "vs-dark",
        "path": "./themes/meridian-dark-umbra-color-theme.json"
      },
      {
        "label": "Meridian Dark Polar Night",
        "uiTheme": "vs-dark",
        "path": "./themes/meridian-dark-polar-night-color-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "tsx build-theme.ts",
    "dev": "tsx src/index.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist themes",
    "generate": "tsx build-theme.ts",
    "validate": "npm run lint && npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "diagnose": "tsx src/tools/diagnostics.ts",
    "package": "vsce package",
    "release:local": "npm run build && npm run package"
  },
  "packageManager": "pnpm@10.33.4",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.7.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
